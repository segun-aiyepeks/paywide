# Blaaiz Remittance-as-a-Service Credentials
# Leave USE_MOCK=true for sandbox/hackathon judge inspection if live sandbox credentials are not present.
USE_MOCK=true

# OAuth 2.0 Credentials (preferred by blaaiz-nodejs-sdk 1.7.0)
BLAAIZ_CLIENT_ID=your_blaaiz_client_id_here
BLAAIZ_CLIENT_SECRET=your_blaaiz_client_secret_here

# Legacy API Key (alternative)
BLAAIZ_API_KEY=

# Base URL (default is https://api-dev.blaaiz.com for sandbox, https://api.blaaiz.com for production)
BLAAIZ_API_URL=https://api-dev.blaaiz.com

# Webhook secret for HMAC-SHA256 signature verification (x-blaaiz-signature, x-blaaiz-timestamp)
BLAAIZ_WEBHOOK_SECRET=whsec_blaaiz_sandbox_secret_key_demo

# Database URL (SQLite locally, PostgreSQL in production)
DATABASE_URL="file:./dev.db"

# Application Settings
NEXT_PUBLIC_APP_NAME="WayPay"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
